{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/berger", "destination": "/berger/", "permanent": true },
    { "source": "/breathwork", "destination": "/breathwork/", "permanent": true },
    { "source": "/report", "destination": "/report/", "permanent": true },
    { "source": "/catalog", "destination": "/catalog/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/apps/index.html" },
    { "source": "/home.js", "destination": "/apps/home.js" },
    { "source": "/registry.js", "destination": "/apps/registry.js" },
    { "source": "/:app(berger|breathwork|report|catalog)/", "destination": "/apps/:app/index.html" },
    { "source": "/:app(berger|breathwork|report|catalog)/:path*", "destination": "/apps/:app/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
